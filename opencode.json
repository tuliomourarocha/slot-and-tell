{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "plugin": [],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow"
  },
  "experimental": {
    "primary_tools": ["edit", "bash"]
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "environment": {
          "CODEGRAPH_TELEMETRY": "0"
        }
      }
    }
  }
}
