# Copie para .env.local e preencha. Nunca commite valores reais.
# Apenas NEXT_PUBLIC_* chega ao navegador.

# Supabase (publicável no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Servidor (somente leitura pelo Node.js; nunca expor)
SUPABASE_SERVICE_ROLE_KEY=

# Integrações (a serem usadas nas fases seguintes)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
JOBS_INVOCATION_SECRET=
